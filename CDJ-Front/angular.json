{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {"packageManager": "npm","analytics": "fe7dfe8f-46ab-4170-936b-7ae46e2ff16f"},
  "newProjectRoot": "projects",
  "projects": {
    "CDJ-Front": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob": "**/*","input": "public"}],
            "styles": ["src/styles.css","src/responsive-fixes.css","src/interaction-polish.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {"type": "initial","maximumWarning": "600kB","maximumError": "1.5MB"},
                {"type": "anyComponentStyle","maximumWarning": "30kB","maximumError": "50kB"}
              ],
              "outputHashing": "all"
            },
            "development": {"optimization": false,"extractLicenses": false,"sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {"buildTarget": "CDJ-Front:build:production"},
            "development": {"buildTarget": "CDJ-Front:build:development"}
          },
          "defaultConfiguration": "development"
        },
        "test": {"builder": "@angular/build:unit-test"}
      }
    }
  }
}
