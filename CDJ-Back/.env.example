# =============================================================================
# Ciudadanía Digital · Backend API
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA commitees `.env` al repo.
# =============================================================================

# --- Base de datos (PostgreSQL) ---
# En dev local con docker compose:
DATABASE_URL="postgresql://cdj:cdj_dev@127.0.0.1:5432/cdj?schema=public"
# En prod (servidor Ubuntu de la SEP) — ejemplo:
# DATABASE_URL="postgresql://cdj_app:STRONG_PASSWORD@10.0.0.5:5432/cdj_prod?schema=public&sslmode=require"

# --- Auth admin ---
# Token Bearer que protege todos los endpoints /api/*  (POST/PUT/PATCH/DELETE)
# Genera uno con: openssl rand -hex 32
ADMIN_TOKEN="change-me-cdj-admin-token-please-use-openssl-rand-hex-32"

# --- CORS ---
# Origen permitido para llamadas desde CDJ-Front. En dev usa el del Angular.
# Múltiples orígenes separados por coma están permitidos en runtime helper.
CORS_ORIGIN="http://localhost:4280"

# --- Storage de imágenes subidas ---
# Carpeta local en dev. En prod puede apuntar a /var/www/cdj-uploads o a S3/MinIO.
UPLOAD_DIR="./public/uploads"
PUBLIC_BASE_URL="http://127.0.0.1:4180"

# --- Next.js ---
NODE_ENV="development"
